# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored, so your keys stay private.
#
# Copy / rename instructions:
#   cp .env.example .env
#
# Then edit `.env` and set your CARTO_API_KEY.

# Logging level used by the app: debug, info, warning, error
APP_LOG_LEVEL = debug

# CARTO basemap tile API key (REQUIRED).
# Get a key at https://carto.com/developers/tiles and paste it here, e.g.:
#   CARTO_API_KEY = default_public_xxxxxxxxxxxxxxxxxxxxx
CARTO_API_KEY = YOUR_CARTO_API_KEY_HERE
