[TEMPLATE]
# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored, so your keys stay private.
#
# Copy / rename instructions:
#   cp .env.example .env
#
# Then set CARTO_API_KEY below. CARTO is the only basemap provider, so the
# generator cannot build a map without it.

# CARTO basemap tile API key (required).
# Get a free key at https://carto.com/developers/tiles and paste it here, e.g.:
#   CARTO_API_KEY = your_key_here
CARTO_API_KEY = your_key_here
