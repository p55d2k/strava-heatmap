# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored, so your keys stay private.
#
# Copy / rename instructions:
#   cp .env.example .env
#
# Then edit `.env` and set your CARTO_API_KEY if you want CARTO basemaps.

# CARTO basemap tile API key (optional; OpenStreetMap is used when absent).
# Get a key at https://carto.com/developers/tiles and paste it here, e.g.:
#   CARTO_API_KEY = your_key_here
CARTO_API_KEY = your_key_here
